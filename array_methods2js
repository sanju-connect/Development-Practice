const products = [
  { name: "Keyboard", price: 1500, inStock: true },
  { name: "Mouse", price: 700, inStock: false },
  { name: "Monitor", price: 12000, inStock: true },
  { name: "USB Cable", price: 300, inStock: true }
];

function getProductSummary(products) {
  const availableProducts = products.map(product => product.inStock).map(product => product.name);

  const affordableCount = products.filter(product => product.price < 2000).length;

  const hasExpensiveProduct = products.some(product => product > 10000);

  return {
    availableProducts: availableProducts,
    affordableCount: affordableCount,
    hasExpensiveProduct: hasExpensiveProduct
  }
}

const summary = getProductSummary(products);

console.log(summary.affordableCount);
console.log(summary.availableProducts);
console.log(summary.hasExpensiveProduct);
